   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "def f(x):\n",
    "    return np.sin(x) + x\n",
    "\n",
    "x = np.linspace(-5, 5, 100)\n",
    "y = f(x)\n",
    "\n",
    "plt.title(\"$\\sin(x) + x$\")\n",
    "plt.plot(x, y, color = \"blue\")\n",
    "plt.grid(\"True\")\n",
    "plt.show"
   ]
  }
