   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "x = np.arange(0, 5*np.pi, 0.1)\n",
    "y = np.sin(x) + x\n",
    "\n",
    "plt.title(\"Plotting sin(x) + x\")\n",
    "plt.ylabel(\"F(x)\")\n",
    "plt.xlabel(\"X-Axis\")\n",
    "plt.plot(x,y, color=\"orange\")\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
  },
